import "problem.zmodel"
import "problemSet.zmodel"

enum TagType {
  SubjectTag @map('subject')
  DifficultyTag @map('difficulty')
  TopicTag @map('topic')
}

model Tag {
  id    String   @id @default(uuid()) @db.Uuid
  type  TagType
  label String   @unique()
  order Int      @default(0)

  @@delegate(type)
}

model SubjectTag extends Tag {
  subject_problems     Problem[]
  subject_problem_sets ProblemSet[]
}

model DifficultyTag extends Tag {
  difficulty_problems     Problem[]
  difficulty_problem_sets ProblemSet[]
}

model TopicTag extends Tag {
  topic_problems     ProblemTopic[]
  topic_problem_sets ProblemSetTopic[]
}
