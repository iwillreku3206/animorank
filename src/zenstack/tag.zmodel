import "problem.zmodel"
import "problemSet.zmodel"

enum TagType {
  SubjectTag @map('subject')
  DifficultyTag @map('difficulty')
  TopicTag @map('topic')
}

enum TagColor {
  TAG_COLOR_DEFAULT @map('default')

  TAG_COLOR_PRIMARY @map('primary')
  TAG_COLOR_SECONDARY @map('secondary')
  TAG_COLOR_ACCENT @map('accent')

  TAG_COLOR_RED @map('red')
  TAG_COLOR_YELLOW @map('yellow')
  TAG_COLOR_GREEN @map('green')
  TAG_COLOR_BLUE @map('blue')
}

model Tag {
  id    String   @id @default(uuid()) @db.Uuid
  type  TagType
  color TagColor @default(TAG_COLOR_DEFAULT)
  label String   @unique()
  order Int      @default(0)

  @@delegate(type)
}

model SubjectTag extends Tag {
  subject_problems     Problem[]
  subject_problem_sets ProblemSet[]
}

model DifficultyTag extends Tag {
  difficulty_problems     Problem[]
  difficulty_problem_sets ProblemSet[]
}

model TopicTag extends Tag {
  topic_problems     ProblemTopic[]
  topic_problem_sets ProblemSetTopic[]
}
