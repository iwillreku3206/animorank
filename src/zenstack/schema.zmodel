datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Language {
  C
}

model ProblemTag {
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     String  @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

model Problem {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  description       String
  language          Language          @default(C)
  starter_code      String            @default("")
  visible           Boolean           @default(true)
  tags              ProblemTag[]
  problem_set_id    String            @db.Uuid
  problem_set       ProblemSet        @relation(fields: [problem_set_id], references: [id], onDelete: Cascade)
  practice_sessions PracticeSession[]
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @updatedAt @db.Timestamptz(6)
  problemTestCases  ProblemTestCase[]
}

enum ProblemTestCaseType {
  FunctionOutputTestCase
  ProgramIOTestCase
  CustomTestCase
}

enum ProblemTestCaseOperator {
  EQUAL
  NOT_EQUAL
  LESS_THAN
  LESS_THAN_EQUAL
  GREATER_THAN
  GREATER_THAN_EQUAL
  WITHIN_RANGE
  LEVENSHTEIN_SIMILARITY
}

model ProblemTestCase {
  id         String              @id @default(uuid()) @db.Uuid
  type       ProblemTestCaseType @default(FunctionOutputTestCase)
  public     Boolean             @default(true)
  problem_id String              @db.Uuid
  problem    Problem             @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @updatedAt @db.Timestamptz(6)

  @@delegate(type)
}

enum BaseType {
  INT
  CHAR
  BOOL
  FLOAT
  DOUBLE
}

enum SizeModifier {
  LONG
  LONG_LONG
  SHORT
}

type CType {
  base            BaseType
  signed          Boolean?      @default(true)
  sizeModifier    SizeModifier?
  arrayDimensions Int[]?
  isPointer       Boolean?      @default(false)
  isString        Boolean?      @default(false)

  @@validate(base == INT || sizeModifier == null, "Size modifier only applies to int")
  @@validate(base == INT || base == CHAR || signed == null, "Signedness only applies to int or char")
  @@validate(base == CHAR || isString == true || isString == false, "isString only applies to char")
  @@validate(base == CHAR || isString == false || isString == null, "isString only applies to char")
}

type CTypeWithValue with CType {
  value String @default("")
}

model FunctionOutputTestCase extends ProblemTestCase {
  parameters      CTypeWithValue[]        @json() @default("[]")
  expected_output CTypeWithValue          @json() @default('{"base": "INT"}')
  operator        ProblemTestCaseOperator @default(EQUAL)
  function_name   String                  @default("")
}

model ProgramIOTestCase extends ProblemTestCase {
  input  String @default("")
  output String @default("")
}

model CustomTestCase extends ProblemTestCase {
  test_code String @default("")
}

enum TagType {
  TAG_SUBJECT @map('subject')
  TAG_DIFFICULTY @map('difficulty')
  TAG_TOPIC @map('topic')
}

enum TagColor {
  TAG_COLOR_DEFAULT @map('default')

  TAG_COLOR_PRIMARY @map('primary')
  TAG_COLOR_SECONDARY @map('secondary')
  TAG_COLOR_ACCENT @map('accent')

  TAG_COLOR_RED @map('red')
  TAG_COLOR_YELLOW @map('yellow')
  TAG_COLOR_GREEN @map('green')
  TAG_COLOR_BLUE @map('blue')
}

model Tag {
  id          String          @id @default(uuid()) @db.Uuid
  type        TagType
  color       TagColor        @default(TAG_COLOR_DEFAULT)
  label       String          @unique()
  order       Int             @default(0)

  problems    ProblemTag[]
  problemSets ProblemSetTag[]
}

model ProblemSetTag {
  problemSetId String     @db.Uuid
  problemSet   ProblemSet @relation(fields: [problemSetId], references: [id], onDelete: Cascade)
  tagId        String     @db.Uuid
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemSetId, tagId])
}

model ProblemSet {
  id            String          @id @default(uuid()) @db.Uuid
  description   String?
  title         String
  owner_id      String?         @db.Uuid
  owner         Teacher?        @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  auto_accept   Boolean         @default(false)
  is_global     Boolean         @default(false)
  tags          ProblemSetTag[]
  problems      Problem[]
  subscriptions Subscription[]
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @updatedAt @db.Timestamptz(6)
}

model PracticeSession {
  id                       String                 @id @default(uuid()) @db.Uuid
  problem_id               String                 @db.Uuid
  problem                  Problem                @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  student_id               String                 @db.Uuid
  student                  Student                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  done                     Boolean                @default(false)
  previous_code            String

  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime               @updatedAt @db.Timestamptz(6)

  practice_history_entries PracticeHistoryEntry[]
}

enum HistoryEntryType {
  TEXT_MODIFIED
  PAGE_OPENED
  PAGE_FOCUS
  RUN_ATTEMPT
  PING
  OTHER
}

model PracticeHistoryEntry {
  id                  String           @id @default(uuid()) @db.Uuid
  timestamp           DateTime         @default(now()) @db.Timestamptz(6)
  type                HistoryEntryType
  data                Json
  practice_session_id String           @db.Uuid
  practice_session    PracticeSession  @relation(fields: [practice_session_id], references: [id], onDelete: Cascade)
}

model Student {
  id                String            @id @default(uuid()) @db.Uuid
  user              User              @relation(fields: [id], references: [id], onDelete: Cascade)
  practice_sessions PracticeSession[]
  subscription      Subscription[]
}

model Subscription {
  problem_set_id String     @db.Uuid
  problem_set    ProblemSet @relation(fields: [problem_set_id], references: [id], onDelete: Cascade)
  student_id     String     @db.Uuid
  student        Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  status         String?
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)

  @@id([problem_set_id, student_id])
}

model Teacher {
  id          String       @id @default(uuid()) @db.Uuid
  user        User         @relation(fields: [id], references: [id], onDelete: Cascade)
  problem_set ProblemSet[]
}

model TeacherList {
  email String @id
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  // Optional for WebAuthn support
  Authenticator  Authenticator[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hasAcceptedTOS Boolean         @default(false)

  student        Student?
  teacher        Teacher?
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String  @db.Uuid
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}
