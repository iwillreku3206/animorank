enum BaseType {
  INT
  CHAR
  BOOL
  FLOAT
  DOUBLE
}

enum SizeModifier {
  LONG
  LONG_LONG
  SHORT
}

type CType {
  base             BaseType
  signed           Boolean?      @default(true)
  size_modifier    SizeModifier?
  array_dimensions Int[]?
  is_pointer       Boolean?      @default(false)
  is_string        Boolean?      @default(false)

  @@validate(base == INT || size_modifier == null, "Size modifier only applies to int")
  @@validate(base == INT || base == CHAR || signed == null, "Signedness only applies to int or char")
  @@validate(base == CHAR || is_string == true || is_string == false, "is_string only applies to char")
  @@validate(base == CHAR || is_string == false || is_string == null, "is_string only applies to char")
}

type CTypeWithValue with CType {
  value String @default("")
}
