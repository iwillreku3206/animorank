		"vite-plugin-monaco-editor-esm": "^2.0.2",
		"vitest": "^1.2.0"
	},
	"type": "module",
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.1",
		"@auth/sveltekit": "^1.11.1",
		"@diplodoc/html-extension": "^2.9.2",
