		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^25.3.3",
		"@types/pg": "^8.18.0",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"autoprefixer": "^10.4.19",
		"daisyui": "^4.10.2",
		"mdsvex": "^0.12.3",
		"monaco-editor": "^0.47.0",
		"postcss": "^8.4.38",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"prisma": "^7.4.2",
