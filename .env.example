# AnimoRank — environment variables.
# Copy to `.env` (gitignored) and fill in the values.
# Generate secrets with: openssl rand -base64 32

# --- Database (PostgreSQL via Prisma / ZenStack) -----------------------------
# https://www.prisma.io/docs/reference/database-reference/connection-urls
DATABASE_URL="postgresql://user:password@localhost:5432/animorank"

# Shadow DB, used only by `prisma migrate` when changing the schema.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/animorank_shadow"

# --- Auth (Auth.js / @auth/sveltekit) ----------------------------------------
# https://authjs.dev/getting-started/installation
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Production --------------------------------------------------------------
# App origin (scheme + host, no trailing slash). Required in production for
# SvelteKit CSRF protection; unused in local dev.
ORIGIN=http://localhost:5173

# --- Code execution (Judge0) — optional --------------------------------------
# Host root, no trailing slash. Leave empty to disable code execution.
JUDGE0_BASE_URL=

# --- Dev & logging — optional ------------------------------------------------
# Enable HTTPS (mkcert) on the vite dev server: true | false.
SSL_DEV_SERVER=false
# Logger backend: console | file.
LOGGER_TYPE=console
# Log file path, used only when LOGGER_TYPE=file.
FILE_LOGGER_FILE=/tmp/animorank.log
